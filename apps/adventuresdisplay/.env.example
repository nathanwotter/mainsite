# Default is safe public samples only. Real source values never go into public/ or Git.
ADVENTURESDISPLAY_MODE=demo
# Household mode needs runtime secrets generated with scripts/hash-password.mjs:
ADMIN_PASSWORD_HASH=
CONFIG_ENCRYPTION_KEY=
# Private recipes-only subscription, server-side only. Never paste into README or source.
PLAN_TO_EAT_FEED_URL=
# Public album source. Used only with both explicit server opt-ins; otherwise diagnostic only.
ICLOUD_ALBUM_URL=
ICLOUD_ALBUM_ACKNOWLEDGED=false
# Extra exact HTTPS hostnames for private calendar/photo sources, comma-separated.
FEED_ALLOWED_HOSTS=
# Keep both privacy-sensitive options disabled until explicitly chosen.
ALLOW_PUBLIC_ICLOUD=false
PRIVATE_OFFLINE_CACHE=false

# Optional one-time administrator enrollment instead of ADMIN_PASSWORD_HASH.
# Generate with scripts/prepare-setup.mjs; never publish the raw setup link.
SETUP_TOKEN_HASH=
SETUP_TOKEN_EXPIRES=
