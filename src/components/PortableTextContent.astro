---
import { PortableText } from 'astro-portabletext';
import { rewriteLegacyFacultyLinks } from '@data/legacyUrls';
import PageFileBlock from './PageFileBlock.astro';
import PageImageBlock from './PageImageBlock.astro';

interface Props {
    value?: any[];
}

const { value = [] } = Astro.props;
const normalizedValue = rewriteLegacyFacultyLinks(value);

const components = {
    type: {
        pageFile: PageFileBlock,
        pageImage: PageImageBlock
    }
};
---

{normalizedValue.length > 0 && (
    <div class="site-typography portable-text-content">
        <PortableText value={normalizedValue} components={components} />
    </div>
)}
