---
import { client } from "../utils/sanity-client";
import SectionLayout from "../layouts/SectionLayout.astro";
import {
  fetchRecreationFuturesSubpages,
  RECREATION_FUTURES_BASE_PATH,
  toSectionNavItems
} from "../data/sectionNav";
import { PORTABLE_BODY } from "../data/portableText";
import { recreationFuturesPageFallback, resolveEditorialPage } from "../data/editorialFallbacks";

const [recreationFuturesPage, recreationFuturesSubpages] = await Promise.all([
  client.fetch(
    `*[_type == "recreationFuturesPage"][0]{
      title,
      shortTitle,
      intro,
      ${PORTABLE_BODY}
    }`
  ),
  fetchRecreationFuturesSubpages()
]);

const resolvedRecreationFuturesPage = resolveEditorialPage(recreationFuturesPage, recreationFuturesPageFallback);
const title = resolvedRecreationFuturesPage?.title ?? "Recreation Futures Lab";
const intro = resolvedRecreationFuturesPage?.intro ?? "";
const body = resolvedRecreationFuturesPage?.body ?? [];
const secondaryNavItems = toSectionNavItems(recreationFuturesSubpages, RECREATION_FUTURES_BASE_PATH);
---

<SectionLayout
  title={title}
  intro={intro}
  body={body}
  secondaryNavTitle="Recreation Futures Lab"
  secondaryNavItems={secondaryNavItems}
  currentPath={RECREATION_FUTURES_BASE_PATH}
  showTitleHeading={false}
/>
