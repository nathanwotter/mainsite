---
import { client } from "../../utils/sanity-client";
import SectionLayout from "../../layouts/SectionLayout.astro";
import { ABOUT_NATHAN_BASE_PATH, fetchAboutNathanSubpages, toSectionNavItems } from "../../data/sectionNav";
import { PORTABLE_BODY } from "../../data/portableText";
import { aboutNathanSubpageFallbacks, resolveEditorialPage } from "../../data/editorialFallbacks";

export async function getStaticPaths() {
  const slugs = await fetchAboutNathanSubpages();

  return slugs.map(({ slug }: { slug: string }) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;

const [aboutNathanSubpage, aboutNathanSubpages] = await Promise.all([
  slug
    ? client.fetch(
        `*[_type == "aboutNathanSubpage" && slug.current == $slug][0]{
          title,
          shortTitle,
          intro,
          ${PORTABLE_BODY}
        }`,
        { slug }
      )
    : null,
  fetchAboutNathanSubpages(),
]);

const resolvedAboutNathanSubpage = resolveEditorialPage(aboutNathanSubpage, aboutNathanSubpageFallbacks[slug]);
const title = resolvedAboutNathanSubpage?.title ?? "About Nathan";
const intro = resolvedAboutNathanSubpage?.intro ?? "";
const body = resolvedAboutNathanSubpage?.body ?? [];
const secondaryNavItems = toSectionNavItems(aboutNathanSubpages, ABOUT_NATHAN_BASE_PATH);
---

<SectionLayout
  title={title}
  intro={intro}
  body={body}
  secondaryNavTitle="About Nathan"
  secondaryNavItems={secondaryNavItems}
  currentPath={`${ABOUT_NATHAN_BASE_PATH}/${slug}`}
/>
