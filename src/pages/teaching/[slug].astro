---
import { client } from "../../utils/sanity-client";
import SectionLayout from "../../layouts/SectionLayout.astro";
import { fetchTeachingSubpages, TEACHING_BASE_PATH, toSectionNavItems } from "../../data/sectionNav";
import { PORTABLE_BODY } from "../../data/portableText";
import { resolveEditorialPage, teachingSubpageFallbacks } from "../../data/editorialFallbacks";

export async function getStaticPaths() {
  const slugs = await fetchTeachingSubpages();

  return slugs.map(({ slug }: { slug: string }) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;

const [teachingSubpage, teachingSubpages] = await Promise.all([
  slug
  ? client.fetch(
      `*[_type == "teachingSubpage" && slug.current == $slug][0]{
        title,
        shortTitle,
        intro,
        ${PORTABLE_BODY}
      }`,
      { slug }
    )
  : null,
  fetchTeachingSubpages()
]);

const resolvedTeachingSubpage = resolveEditorialPage(teachingSubpage, teachingSubpageFallbacks[slug]);
const title = resolvedTeachingSubpage?.title ?? "Teaching";
const intro = resolvedTeachingSubpage?.intro ?? "";
const body = resolvedTeachingSubpage?.body ?? [];
const secondaryNavItems = toSectionNavItems(teachingSubpages, TEACHING_BASE_PATH);
---

<SectionLayout
  title={title}
  intro={intro}
  body={body}
  secondaryNavTitle="Teaching"
  secondaryNavItems={secondaryNavItems}
  currentPath={`${TEACHING_BASE_PATH}/${slug}`}
/>
